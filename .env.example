# SaaS tenant hostname, or your on-prem Security Engine Node FQDN.
# NOT cloud.tenable.com — that is Tenable Vulnerability Management, a different
# product with a different credential format (accessKey/secretKey, X-ApiKeys).
TIE_URL=https://your-client.tenable.ad

# TIE console -> user profile icon -> My Account / Preferences -> API key
TIE_API_KEY=your-api-key-here

# Set to false for an on-prem appliance with a self-signed or internal-CA cert.
TIE_VERIFY_SSL=true

# Leave false unless you deliberately want the model to be able to mutate the
# console. api-key/users/roles/authentication resources stay read-only regardless.
TIE_ALLOW_WRITES=false
