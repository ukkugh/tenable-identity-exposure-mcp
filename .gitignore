# Credentials. The README tells operators to create .env and a Claude Desktop
# config holding a live TIE API key, so those names are ignored up front —
# a bare ".env" line does not cover .env.local or .env.prod.
.env
.env.*
!.env.example
claude_desktop_config.json
*.pem
*.key

.DS_Store
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
